# GROMACS Radius of Gyration Output (gmx gyrate)
# Command: gmx gyrate -f elp_quench.xtc -s elp_quench.tpr -o gyrate.xvg
@    title "Radius of gyration"
@    xaxis  label "Time (ps)"
@    yaxis  label "Radius of Gyration (nm)"
@TYPE xy
@ view 0.15, 0.15, 0.75, 0.85
@ legend on
@ s0 legend "Rg"
@ s1 legend "Rg X"
@ s2 legend "Rg Y"
@ s3 legend "Rg Z"
         0.0000000   18.4215   10.2140   11.4502   12.1051
       500.0000000   16.8912    9.8402   10.2105   11.0201
      1000.0000000   14.7501    8.9201    9.4501    9.8902
      2000.0000000   12.8904    7.8401    8.2104    8.7501
      5000.0000000   10.8201    6.7502    7.1050    7.4201
     10000.0000000    9.9502    6.1204    6.4501    6.8102
     20000.0000000    9.8105    6.0105    6.3402    6.7201
     50000.0000000    9.7801    5.9802    6.3105    6.6902
    100000.0000000    9.7904    5.9901    6.3201    6.7001
