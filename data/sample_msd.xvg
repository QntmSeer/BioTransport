# GROMACS Mean Squared Displacement Output (gmx msd)
# Command: gmx msd -f elp_quench.xtc -s elp_quench.tpr -o msd.xvg
@    title "Mean Squared Displacement"
@    xaxis  label "Time (ps)"
@    yaxis  label "MSD (nm\S2\N)"
@TYPE xy
         0.0000000    0.00000
       100.0000000    0.01045
       200.0000000    0.02102
       500.0000000    0.05210
      1000.0000000    0.10425
      2000.0000000    0.20890
      5000.0000000    0.52140
     10000.0000000    1.04350
